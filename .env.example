###############################################################################
# Alta Agent Studio — ONE configuration file. Copy this to `.env` and fill in.
#
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows cmd)   /   Copy-Item .env.example .env (PS)
#
# Every component (the AI builder, the platform API, the Vapi voice runtime)
# loads THIS file via builder_platform/env_bootstrap.py, and the subprocesses
# they spawn inherit it. No shell profile or per-directory setup required.
# `.env` is gitignored — your real keys never get committed.
###############################################################################

# ── The AI Builder (Claude Agent SDK) — TWO SUPPORTED MODES, YOU CHOOSE ──────
# The builder runs on Claude via the Agent SDK. Pick how it authenticates:
#
#   MODE A — API key (recommended for a shared/reviewed deploy):
#     Set ANTHROPIC_API_KEY below. Usage bills to that key; fully portable,
#     no local login required. Get one at https://console.anthropic.com/ .
#
#   MODE B — existing Claude subscription/login (zero-config on your own machine):
#     Leave ANTHROPIC_API_KEY BLANK. The builder uses whatever Claude auth this
#     machine already has (a Claude Pro/Max login / `claude` CLI session).
#
# Both are first-class — the builder detects which to use at startup and logs
# it. A blank or unfilled [placeholder] value cleanly selects Mode B.
ANTHROPIC_API_KEY=

# ── Vapi (voice transport) ──────────────────────────────────────────────────
# Only needed to place a real test call; the builder + selftest work without it.
# In the reviewed submission these arrive PRE-FILLED with deliberately scoped,
# restricted demo credentials — reviewers don't need a Vapi account.
# VAPI_SERVER_SECRET — set the SAME value as your assistant's serverUrlSecret in
#   the Vapi dashboard; Vapi sends it back on every inbound custom-LLM request.
# VAPI_PRIVATE_KEY — Vapi dashboard -> Account / API Keys -> Private Key; used
#   when the platform calls Vapi's REST API (patch assistant, place calls).
# VAPI_PUBLIC_KEY — dashboard Public Key; safe for the browser, used by the
#   in-page web-call widget.
# VAPI_ASSISTANT_ID — the Vapi assistant the platform points at this machine.
VAPI_SERVER_SECRET=
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=

# ── LLM for the GENERATED voice agent (PROVIDER-AGNOSTIC) ────────────────────
# The generated agent binds NO provider — it speaks only an OpenAI-compatible
# /v1 endpoint, chosen entirely here. Any of these drop in by editing these
# lines alone (zero code change):
#   OpenAI ...... leave OPENAI_BASE_URL blank (defaults to api.openai.com/v1)
#   Mistral ..... OPENAI_BASE_URL=https://api.mistral.ai/v1
#   Groq ........ OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   Together .... OPENAI_BASE_URL=https://api.together.xyz/v1
#   OpenRouter .. OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   local vLLM /
#     Ollama .... OPENAI_BASE_URL=http://localhost:11434/v1  (key = any string)
# Leave OPENAI_API_KEY BLANK to run the agent in deterministic MOCK mode
# (no live LLM calls) — this is what the selftest gate runs against.
OPENAI_API_KEY=
OPENAI_BASE_URL=
AGENT_INTENT_MODEL=gpt-4o-mini    # cheap/fast: classification + slot extraction
AGENT_ANSWER_MODEL=gpt-4o-mini    # reasoning / Think->Act (escalate here first)
AGENT_ENRICH_MODEL=gpt-4o-mini    # SLM: phrase tool results warmly

# ── Voice runtime knobs (optional; sane defaults in code) ───────────────────
BRAIN_MODE=live                   # live = generated agent answers; skeleton = hardcoded (tunnel debugging)
AGENT_DIR=                        # path to the generated agent to serve; blank = runtime default
RAW_CAPTURE=1                     # dump each raw Vapi POST to builder_platform/vapi_raw_capture.jsonl
RUNTIME_TURN_TIMEOUT_S=45         # queue.get() ceiling before the spoken apology fires
RUNTIME_PORT=8000                 # voice-runtime port — MUST differ from the app's 8100
PUBLIC_URL=                       # https tunnel URL for Vapi (blank = auto-detect ngrok)

# ── Builder tuning (optional) ───────────────────────────────────────────────
# BUILDER_MODEL=sonnet            # the builder's Claude model (default: sonnet)
# WORKSPACES_DIR=                 # where generated agents are written (default: <repo>/workspaces)
# SELFTEST_TIMEOUT_S=300          # per-generation selftest subprocess ceiling
