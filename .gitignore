# ── Secrets — never commit real credentials ─────────────────────────────────
# The `!**/.env.example` negation below is REQUIRED (the templates are the
# documented setup surface) but it is also how a live key once reached a public
# commit: a scaffolder copied .env -> .env.example without stripping values, and
# the negation re-admitted the file that `**/.env` had correctly excluded.
# A template is ignore-exempt, NOT review-exempt — every .env.example must ship
# with empty values. Enforce with a secret scanner, not with this file alone.
.env
builder_platform/.env
**/.env
.env.*
!.env.example
!**/.env.example

# Credential artifacts (OAuth clients, tokens, service accounts, keys)
credentials.json
client_secret*.json
token*.json
*-service-account.json
service_account*.json
*.pem
*.key
*.p12
.credentials/
secrets/

# ── Generated agents (builder output) — regenerated, not source ─────────────
workspaces/

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# ── Local databases / scratch ───────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
builder_platform/vapi_raw_capture.jsonl
*.log
listen.txt

# ── Claude Code local state (machine-local, never shared) ───────────────────
.claude/settings.local.json
.claude/scheduled_tasks.lock

# ── Not part of the submission ──────────────────────────────────────────────
submission_skeleton.txt
TASKS.MD
*.backup
