# Environment template — copy to `.env` and fill in. Auto-loaded (python-dotenv).
# Leave the key blank for deterministic MOCK mode (no credentials needed;
# the full pipeline still runs).
#
# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ PROVIDER-AGNOSTIC BY CONTRACT — THIS AGENT BINDS NO LLM PROVIDER.        ║
# ║                                                                          ║
# ║ The agent talks ONLY to an OpenAI-compatible /v1 endpoint. You choose    ║
# ║ the provider entirely HERE, by env — never by editing code:              ║
# ║   • OpenAI ........ BASE_URL blank (defaults to api.openai.com/v1)        ║
# ║   • Mistral ....... BASE_URL=https://api.mistral.ai/v1                    ║
# ║   • Groq .......... BASE_URL=https://api.groq.com/openai/v1               ║
# ║   • Together ...... BASE_URL=https://api.together.xyz/v1                  ║
# ║   • OpenRouter .... BASE_URL=https://openrouter.ai/api/v1                 ║
# ║   • Azure OpenAI .. BASE_URL=https://<resource>.openai.azure.com/...      ║
# ║   • local vLLM /                                                          ║
# ║     Ollama ........ BASE_URL=http://localhost:11434/v1  (key any string)  ║
# ║ Any /v1-compatible provider drops in by changing these three lines and   ║
# ║ the three model names below. Zero code change. Do not hardcode a         ║
# ║ provider, import a vendor SDK, or read a vendor-specific key anywhere.    ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Endpoint (any OpenAI-compatible API) ───────────────────────────────────
# Leave OPENAI_API_KEY blank for deterministic MOCK mode. Leave OPENAI_BASE_URL
# blank to hit api.openai.com. Keep BOTH values empty (no inline comment on the
# same line — python-dotenv parses an inline comment AS the value when the value
# is otherwise empty, which silently breaks MOCK detection and the base URL).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini                   # fallback when a tier below is unset

# ── Model tiers (multi-model chain) ─────────────────────────────────────────
# The three roles CAN run on different capability levels — the architecture's
# point is SEPARATE roles, not one model. Historically INTENT/ENRICH stayed
# small for time-to-first-byte and only ANSWER needed to reason; running
# everything on one SMALL model was a known failure (the ANSWER tier ignored
# embedded questions, ENRICH invented follow-ups the graph has no flow for).
# Voice deployment (references/Voice_Architecture_Principles.txt) makes this a
# latency budget: INTENT and ENRICH sit on the time-to-first-byte path.
# ALL THREE TIERS SET TO gpt-4o (2026-07-20, operator decision — uniform
# quality/consistency across tiers for the demo). This deliberately trades away
# the INTENT/ENRICH latency+cost advantage (a bigger model on the
# time-to-first-byte path; ENRICH is a FRAMED structured-verdict tier that
# gains little from more capacity). To restore the tiered default, put INTENT
# and ENRICH back on gpt-4o-mini. Per Voice_SDR_Reliability.txt Rule 4, a
# missing fact/pitch/framing is a content bug no model tier fixes.
AGENT_INTENT_MODEL=gpt-4o             # classification + slot extraction
AGENT_ANSWER_MODEL=gpt-4o             # answering + Think->Act reasoning
AGENT_ENRICH_MODEL=gpt-4o             # SLM: phrase tool results (framed verdict)

# ── Mistral instead of OpenAI ───────────────────────────────────────────────
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.mistral.ai/v1
# OPENAI_MODEL=mistral-small-latest
# AGENT_ANSWER_MODEL=mistral-large-latest    # Mistral: keep ANSWER on the large tier

# ── Safety rails (defaults live in config.py) ──────────────────────────────
# MAX_TOOL_CALLS_PER_TURN=3                 # circuit breaker: tool budget per turn
# RAG_MAX_ITERATIONS=2                      # Agentic-RAG rewrite bound (each loop = 2 extra LLM calls of visible latency)
# RAG_TIMEOUT_SECONDS=3.0                   # wall clock for the whole retrieval loop; on timeout: single-hop degrade
# MAX_PLAN_STEPS=3                          # compound-plan ceiling; keep <= MAX_TOOL_CALLS_PER_TURN
# FAST_ROUTER_ENABLED=1                     # tier-0 deterministic gate: skip the INTENT call for unambiguous mid-flow slot answers
# STALL_THRESHOLD=3                         # stall detector: N-th consecutive identical reply -> clarify-then-escalate (0 = off)
# RETRIEVAL_MIN_SCORE=0                     # RAG confidence floor; ~0.70 for live cosine retrievers (0 fits the mock overlap scorer)
# RAG_CACHE_TTL_SECONDS=300                 # TTL cache for retrieval context; exact-match repeats skip the whole loop (0 = off)

# ── Filler channel (canned pre-answer acknowledgments; see references/Filler_Channel.txt) ──
# FILLER_ENABLED=1                          # tool-aware "let me check…" fillers over a frontend-agnostic sink (0 -> legacy dot-spinner)
# FILLER_DELAY_MS=300                       # emit a filler only if the tool outlasts this; set 0 for a voice/SSE frontend (always cover the gap)

# ── Outbound email tool (tools.send_email) ─────────────────────────────────
# Credentials live HERE, never in source. Leave SMTP_USER/SMTP_PASSWORD blank
# for MOCK mode (no network; the tool reports a mock send) so the agent and its
# selftest run credential-free. For Gmail use an App Password (not the account
# password). SMTP_TIMEOUT_S bounds the send so a hung server can't cause dead air.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=                                # defaults to SMTP_USER
# SMTP_TIMEOUT_S=10

# ── Debug ──────────────────────────────────────────────────────────────────
# SHOW_TRACE=1                              # print per-turn intent/tool routing
