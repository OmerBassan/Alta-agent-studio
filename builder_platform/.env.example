# Platform env — copy to `.env` and fill in. Auto-loaded by vapi_adapter.py
# (python-dotenv) before the generated agent is imported.

# ── Vapi auth (inbound: Vapi -> us) ─────────────────────────────────────────
# LEAVE BLANK for a browser test call.
#
# Vapi CANNOT send a shared secret to a custom-llm model url. Probed against the
# live API on 2026-07-17: PATCHing `model.secret` returns
#     400 {"message":["model.property secret should not exist"]}
# and the flight-proven assistant carries no serverUrlSecret either. So Vapi
# sends NO auth header to /v1/chat/completions. If this var is set, the adapter
# 401s every turn and the call connects but never speaks — silent dead air, the
# single most expensive failure mode this project has hit.
#
# POST /api/call therefore REFUSES to start while this is set, rather than let
# the demo die quietly. The tunnel URL is random and short-lived; only expose
# the runtime while you are actually demoing.
VAPI_SERVER_SECRET=

# ── Vapi Private API Key (outbound: us -> Vapi) ─────────────────────────────
# Dashboard: Account / API Keys -> Private Key. Sent as `Authorization: Bearer`
# when WE call Vapi's REST API — POST /api/call uses it to PATCH the assistant's
# custom-llm url to this machine's tunnel. Server-side ONLY; never reaches the
# browser.
VAPI_PRIVATE_KEY=

# ── Vapi Public API Key (browser -> Vapi) ───────────────────────────────────
# Dashboard: Account / API Keys -> Public Key. POST /api/call hands this to the
# page so the Vapi Web SDK can open a browser-microphone call (no phone number
# involved). Safe to expose — it is the only Vapi key the browser ever sees.
VAPI_PUBLIC_KEY=

# ── The assistant to drive ──────────────────────────────────────────────────
# Dashboard: Assistants -> the assistant -> its id. The platform rewrites ONLY
# its model.url; voice, transcriber, firstMessage and system messages stay
# exactly as configured in the dashboard.
VAPI_ASSISTANT_ID=

# ── Public URL for the runtime ──────────────────────────────────────────────
# An https URL that reaches this machine's RUNTIME_PORT. Leave blank to
# auto-adopt a running `ngrok http 8100` via ngrok's local agent API. Set it
# explicitly to use cloudflared or a real host. The platform does NOT manage the
# tunnel process — start it yourself.
PUBLIC_URL=

# The port the voice runtime subprocess binds. Your tunnel must forward to it.
RUNTIME_PORT=8100

# ── Brain selection ──────────────────────────────────────────────────────
# live      = the loaded generated agent answers (default)
# skeleton  = Day-1-AM hardcoded reply, for round-trip/tunnel debugging
BRAIN_MODE=live

# ── Generated agent to load ──────────────────────────────────────────────
# Absolute or relative-to-platform/ path. Empty -> runtime.py's
# DEFAULT_AGENT_DIR (the NorthwindSDR project).
AGENT_DIR=

# ── LLM for the loaded agent (PROVIDER-AGNOSTIC — set here, or in the agent's ──
#    own .env). The platform loads this file BEFORE importing the agent, and the
#    agent's load_dotenv never overrides an already-set env var, so values here
#    win for the live voice runtime. The agent speaks ONLY an OpenAI-compatible
#    /v1 endpoint — any provider drops in by these vars alone, zero code change.
#    Blank OPENAI_API_KEY -> deterministic MOCK mode (no live calls).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                # blank = OpenAI; e.g. https://api.mistral.ai/v1, https://api.groq.com/openai/v1
# AGENT_INTENT_MODEL=gpt-4o-mini  # cheap/fast classification + slot extraction
# AGENT_ANSWER_MODEL=gpt-4o-mini  # reasoning / Think->Act (escalate here first if flight tests need it)
# AGENT_ENRICH_MODEL=gpt-4o-mini  # SLM: phrase tool results warmly

# ── Diagnostics ───────────────────────────────────────────────────────────
RAW_CAPTURE=1                 # dump each raw Vapi POST body to vapi_raw_capture.jsonl
RUNTIME_TURN_TIMEOUT_S=45     # queue.get() ceiling before the spoken apology fires
