{
  "description": "Guards engine files inside Alta-managed generated-agent projects only; silently no-ops everywhere else.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/claude_plugin/hooks/guard_engine_files.py\" pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/claude_plugin/hooks/guard_engine_files.py\" post"
          }
        ]
      }
    ]
  }
}
